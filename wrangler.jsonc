{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "internal-spec-rag",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI" },
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "spec-index" }
  ],
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spec-docs",
      "database_id": "748de0c1-88b2-4484-903d-28428703a25d"
    }
  ]
}
